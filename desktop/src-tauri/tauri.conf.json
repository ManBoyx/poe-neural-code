{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eclipse",
  "mainBinaryName": "eclipse-terminal",
  "version": "0.3.0",
  "identifier": "io.github.manboyx.eclipse",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eclipse",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#0e0e18",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "nsis",
      "msi"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Eclipse Desktop : programmez avec Claude Code, Poe et d'autres IA",
    "longDescription": "Interface graphique d'Eclipse : conversations, choix du modèle, autorisations avant chaque modification, consommation et budgets.",
    "publisher": "ManBoyx",
    "copyright": "© 2026 ManBoyx. Tous droits réservés.",
    "license": "LicenseRef-Proprietary",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/engine/dist/eclipse-engine/": "engine/"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "section": "devel"
      },
      "rpm": {
        "release": "1"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "fr-FR"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
