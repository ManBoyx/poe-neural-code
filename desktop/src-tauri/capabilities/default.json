{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Droits de la fenêtre principale : strict minimum (presse-papiers texte, liens web, choix d'un dossier).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
