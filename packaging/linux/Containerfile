# Environnement de construction Linux identique à la CI (Ubuntu 22.04 : glibc 2.35, binaires compatibles avec
# la plupart des distributions récentes). Usage local : packaging/linux/build-local.sh
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl wget file ca-certificates git pkg-config xz-utils rpm \
      libwebkit2gtk-4.1-dev libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://nodejs.org/dist/v22.21.1/node-v22.21.1-linux-x64.tar.xz | tar -xJ -C /opt \
    && ln -s /opt/node-v22.21.1-linux-x64/bin/* /usr/local/bin/
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
# Python autonome (python-build-standalone via uv) : le moteur ne dépend d'aucune bibliothèque Python du système.
RUN curl -fsSL https://github.com/astral-sh/uv/releases/download/0.9.9/uv-x86_64-unknown-linux-gnu.tar.gz | tar -xz -C /usr/local/bin --strip-components=1 \
    && uv python install 3.12
WORKDIR /src
